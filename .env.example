# Copie para .env.local e preencha.

# String de conexão do MongoDB
MONGODB_URI=mongodb://localhost:27017/afps

# NextAuth — gere o segredo com: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Opcional — usados apenas por `npm run seed`
# Se SEED_ADMIN_PASSWORD ficar vazio, uma senha aleatória é gerada e exibida.
SEED_ADMIN_EMAIL=admin@portodossantos.com
SEED_ADMIN_PASSWORD=
